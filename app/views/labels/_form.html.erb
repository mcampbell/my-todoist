<%= form_with model: label do |f| %>
  <% if label.errors.any? %>
    <div class="notification is-danger">
      <ul>
        <% label.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, class: "label" %>
    <div class="control">
      <%= f.text_field :name, class: "input" %>
    </div>
  </div>

  <div class="control">
    <%= f.submit "Save", class: "button is-primary" %>
    <%= link_to "Cancel", labels_path, class: "button is-light" %>
  </div>
<% end %>
