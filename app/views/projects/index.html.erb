<div class="level">
  <h1 class="title level-left">Projects</h1>
  <%= link_to "New project", new_project_path, class: "button is-primary level-right" %>
</div>

<% if @projects.empty? %>
  <p class="has-text-grey">No projects yet.</p>
<% else %>
  <table class="table is-fullwidth is-hoverable is-vcentered">
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= link_to project.name, project_tasks_path(project) %></td>
          <td class="is-narrow">
            <%= link_to edit_project_path(project), class: "button is-small is-white", "aria-label": "Edit #{project.name}" do %>
              <span class="icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16.86 4.49l2.65 2.65M3 21l4.5-1.13a4.5 4.5 0 001.9-1.13l9.36-9.36a1.87 1.87 0 000-2.65l-.94-.94a1.87 1.87 0 00-2.65 0L5.26 15.6a4.5 4.5 0 00-1.13 1.9L3 21z"/>
                </svg>
              </span>
            <% end %>
            <%= button_to project_path(project), method: :delete, class: "button is-small is-white has-text-danger", form_class: "is-inline-block", "aria-label": "Delete #{project.name}", data: { turbo_confirm: "Delete this project? Its tasks move to Inbox." } do %>
              <span class="icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 7h16M10 11v6M14 11v6M5 7l1 13a2 2 0 002 2h8a2 2 0 002-2l1-13M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/>
                </svg>
              </span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
