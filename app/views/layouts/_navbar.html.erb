<aside class="menu">
  <p class="menu-label">My Todoist</p>
  <ul class="menu-list">
    <li><%= link_to "Inbox", root_path %></li>
    <li><%= link_to "Overdue", overdue_tasks_path %></li>
    <li><%= link_to "Today", today_tasks_path %></li>
    <li><%= link_to "Upcoming", upcoming_tasks_path %></li>
    <li><%= link_to "Completed", completed_tasks_path %></li>
    <li><%= link_to "Search", search_tasks_path %></li>
    <li><%= link_to "New task", new_task_path(return_to: request.path) %></li>
  </ul>

  <p class="menu-label">Projects</p>
  <ul class="menu-list">
    <% Project.order(:name).each do |project| %>
      <li><%= link_to project.name, project_tasks_path(project), style: "background-color: #{project_tint(project)}" %></li>
    <% end %>
    <li><%= link_to "Manage projects", projects_path %></li>
    <li><%= link_to "Manage labels", labels_path %></li>
  </ul>
</aside>
