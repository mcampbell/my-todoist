<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "My Todoist" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="My Todoist">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="seconds-until-midnight" content="<%= seconds_until_midnight %>">
    <meta name="script-name" content="<%= request.script_name %>">


    <%= yield :head %>

    <link rel="icon" href="<%= request.script_name %>/icon.png" type="image/png">
    <link rel="icon" href="<%= request.script_name %>/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= request.script_name %>/icon.png">

    <%= stylesheet_link_tag "bulma.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div id="toast-container" data-turbo-permanent aria-live="polite"></div>
    <main class="section">
      <div class="columns">
        <% if authenticated? %>
          <input type="checkbox" id="nav-drawer" class="nav-drawer-toggle"
                 aria-label="Toggle navigation menu">
          <label for="nav-drawer" class="nav-toggle">Menu</label>
          <div class="column is-narrow nav-sidebar">
            <%= render "layouts/navbar" %>
          </div>
        <% end %>
        <div class="column nav-main">
          <% flash.each do |type, message| %>
            <div class="notification is-<%= type == "alert" ? "danger" : "success" %>">
              <%= message %>
            </div>
          <% end %>
          <%= yield %>
        </div>
      </div>
    </main>
  </body>
</html>
