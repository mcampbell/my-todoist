<div class="level">
  <h1 class="title level-left">Tasks</h1>
  <%= link_to "New task", new_task_path, class: "button is-primary level-right" %>
</div>

<% if @tasks.empty? %>
  <p class="has-text-grey">Nothing to do. Add a task.</p>
<% else %>
  <table class="table is-fullwidth is-hoverable">
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td>
            <strong><%= task.title %></strong>
            <% if task.due_at %>
              <span class="tag is-info is-light"><%= format_time(task.due_at) %></span>
            <% end %>
          </td>
          <td class="has-text-right">
            <%= button_to "Complete", complete_task_path(task), method: :patch, class: "button is-small is-success" %>
            <%= link_to "Edit", edit_task_path(task), class: "button is-small" %>
            <%= button_to "Delete", task_path(task), method: :delete, class: "button is-small is-danger is-light", data: { turbo_confirm: "Delete this task?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
