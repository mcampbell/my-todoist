<div class="level">
  <h1 class="title level-left"><%= @project&.name || "Inbox" %></h1>
  <%= link_to "New task", new_task_path, class: "button is-primary level-right" %>
</div>

<% if @tasks.empty? %>
  <p class="has-text-grey">Nothing to do. Add a task.</p>
<% else %>
  <table class="table is-fullwidth is-hoverable is-vcentered">
    <tbody>
      <%= render @tasks %>
    </tbody>
  </table>
<% end %>
