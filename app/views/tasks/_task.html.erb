<tr>
  <td class="is-narrow">
    <%= button_to complete_task_path(task), method: :patch, class: "button is-small is-white", form_class: "is-inline-block", "aria-label": "Complete #{task.title}" do %>
      <span class="icon">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="4" y="4" width="16" height="16" rx="4"/>
        </svg>
      </span>
    <% end %>
  </td>
  <td>
    <%= priority_badge(task) %>
    <strong><%= task.title %></strong>
    <% if task.due_at %>
      <span class="tag is-info is-light"><%= format_time(task.due_at) %></span>
    <% end %>
    <% task.labels.sort_by(&:name).each do |label| %>
      <span class="tag is-light"><%= label.name %></span>
    <% end %>
  </td>
  <td class="is-narrow">
    <%= link_to edit_task_path(task), class: "button is-small is-white", "aria-label": "Edit #{task.title}" do %>
      <span class="icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16.86 4.49l2.65 2.65M3 21l4.5-1.13a4.5 4.5 0 001.9-1.13l9.36-9.36a1.87 1.87 0 000-2.65l-.94-.94a1.87 1.87 0 00-2.65 0L5.26 15.6a4.5 4.5 0 00-1.13 1.9L3 21z"/>
        </svg>
      </span>
    <% end %>
    <%= button_to task_path(task), method: :delete, class: "button is-small is-white has-text-danger", form_class: "is-inline-block", "aria-label": "Delete #{task.title}", data: { turbo_confirm: "Delete this task?" } do %>
      <span class="icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h16M10 11v6M14 11v6M5 7l1 13a2 2 0 002 2h8a2 2 0 002-2l1-13M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/>
        </svg>
      </span>
    <% end %>
  </td>
</tr>
