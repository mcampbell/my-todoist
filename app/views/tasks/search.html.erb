<%= render "page_header", title: "Search" %>

<%= form_with url: search_tasks_path, method: :get, local: true do %>
  <div class="field has-addons">
    <div class="control is-expanded">
      <%= text_field_tag :q, @query, class: "input", placeholder: "Search tasks", autofocus: true %>
    </div>
    <div class="control">
      <%= submit_tag "Search", class: "button is-primary" %>
    </div>
    <div class="control">
      <%= link_to "Cancel", root_path, id: "cancel-link", class: "button is-light" %>
    </div>
  </div>
  <%# A link, not a JS-driven checkbox: clicking re-runs the search with the
      flipped include_completed, so it works under rack_test with no browser.
      The link navigates on its own; the hidden field carries the current
      state through the Search button. The two never post together. %>
  <%= hidden_field_tag :include_completed, (@include_completed ? "1" : "0") %>
  <div class="field">
    <%= link_to search_tasks_path(q: @query, include_completed: (@include_completed ? "0" : "1")),
          id: "toggle-completed", class: "is-clickable" do %>
      <%= @include_completed ? "☑" : "☐" %> Include completed tasks
    <% end %>
  </div>
<% end %>

<% if @query.present? %>
  <% if @tasks.empty? && @completed_occurrences.empty? %>
    <p class="has-text-grey">No matches.</p>
  <% else %>
    <table class="table is-fullwidth is-hoverable is-vcentered">
      <tbody>
        <%= render @tasks %>
        <%= render partial: "completed_result", collection: @completed_occurrences, as: :occurrence %>
      </tbody>
    </table>
  <% end %>
<% end %>
