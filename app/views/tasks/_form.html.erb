<%= form_with model: task do |f| %>
  <% if task.errors.any? %>
    <div class="notification is-danger">
      <ul>
        <% task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "label" %>
    <div class="control">
      <%= f.text_field :title, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :notes, class: "label" %>
    <div class="control">
      <%= f.text_area :notes, class: "textarea" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :due_at, "Due", class: "label" %>
    <div class="control">
      <%= f.datetime_field :due_at, class: "input" %>
    </div>
  </div>

  <div class="control">
    <%= f.submit "Save", class: "button is-primary" %>
    <%= link_to "Cancel", tasks_path, class: "button is-light" %>
  </div>
<% end %>
