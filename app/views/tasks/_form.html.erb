<%= form_with model: task do |f| %>
  <% if task.errors.any? %>
    <div class="notification is-danger">
      <ul>
        <% task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "label" %>
    <div class="control">
      <%= f.text_field :title, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :notes, class: "label" %>
    <div class="control">
      <%= f.text_area :notes, class: "textarea" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :due_at, "Due", class: "label" %>
    <div class="control">
      <%= f.datetime_field :due_at, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :project_id, "Project", class: "label" %>
    <div class="control">
      <div class="select">
        <%= f.collection_select :project_id, Project.order(:name), :id, :name, include_blank: "Inbox" %>
      </div>
    </div>
  </div>

  <div class="field">
    <%= f.label :priority, class: "label" %>
    <div class="control">
      <div class="select">
        <%= f.select :priority, (0..3).map { |n| ["P#{n}", n] } %>
      </div>
    </div>
  </div>

  <% if Label.exists? %>
    <div class="field">
      <label class="label">Labels</label>
      <div class="control">
        <%= f.collection_check_boxes :label_ids, Label.order(:name), :id, :name do |b| %>
          <label class="checkbox mr-3"><%= b.check_box %> <%= b.text %></label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="control">
    <%= f.submit "Save", class: "button is-primary" %>
    <%= link_to "Cancel", task_list_path(task), class: "button is-light" %>
  </div>
<% end %>
