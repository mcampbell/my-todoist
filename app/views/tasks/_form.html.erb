<%= form_with model: task do |f| %>
  <% if params[:return_to].present? %>
    <%= hidden_field_tag :return_to, params[:return_to] %>
  <% end %>
  <% if task.errors.any? %>
    <div class="notification is-danger">
      <ul>
        <% task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "label" %>
    <div class="control">
      <%= f.text_field :title, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :notes, class: "label" %>
    <div class="control">
      <%= f.text_area :notes, class: "textarea" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :due_date, "Due date", class: "label" %>
    <div class="control">
      <%= f.date_field :due_date, class: "input" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :due_time, "Due time (optional)", class: "label" %>
    <div class="field has-addons">
      <div class="control">
        <%= f.time_field :due_time, class: "input" %>
      </div>
      <div class="control">
        <button type="button" id="clear-due-time" class="button is-light">Clear time</button>
      </div>
    </div>
    <p class="help">Clear the time to make this an all-day task.</p>
  </div>

  <% if task.persisted? %>
    <div class="field">
      <%= label_tag :reschedule_to, "Reschedule to (e.g. tomorrow, next wed, in 2 months)", class: "label" %>
      <div class="control">
        <%= text_field_tag :reschedule_to, @reschedule_to, class: "input", placeholder: "tomorrow / next friday 3pm / in 2 months" %>
      </div>
      <p class="help">Sets the due date from free text. For a recurring task it moves the next occurrence only. Don't also use the date pickers.</p>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :recurrence, "Recurrence (e.g. every 3 days, every! monday)", class: "label" %>
    <div class="control">
      <%= f.text_field :recurrence, class: "input", placeholder: "every day / every! monday / every 3 months" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :project_id, "Project", class: "label" %>
    <div class="control">
      <div class="select">
        <%= f.collection_select :project_id, Project.order(:name), :id, :name, include_blank: "Inbox" %>
      </div>
    </div>
  </div>

  <div class="field">
    <%= f.label :priority, class: "label" %>
    <div class="control">
      <div class="select">
        <%= f.select :priority, priority_select_options %>
      </div>
    </div>
  </div>

  <% if Label.exists? %>
    <div class="field">
      <label class="label">Labels</label>
      <div class="control">
        <%= f.collection_check_boxes :label_ids, Label.order(:name), :id, :name do |b| %>
          <label class="checkbox mr-3"><%= b.check_box %> <%= b.text %></label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="control">
    <%= f.submit "Save", class: "button is-primary" %>
    <%= link_to "Cancel", safe_return_to || task_list_path(task), class: "button is-light" %>
  </div>
<% end %>
