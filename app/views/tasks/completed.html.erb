<%= render "page_header", title: "Completed" %>

<% if @occurrences.empty? %>
  <p class="has-text-grey">No completed tasks yet.</p>
<% else %>
  <%= render "pager", page: @page, last_page: @last_page if @last_page > 1 %>
  <table class="table is-fullwidth">
    <tbody>
      <% @occurrences.each do |occurrence| %>
        <tr>
          <td><s><%= occurrence.task_title %></s>
            <%= link_to "Details", completed_occurrence_path(occurrence), class: "has-text-grey" %>
            <% if (preview = notes_preview(occurrence.completion_notes)) %>
              <p class="task-notes is-size-7 has-text-grey"><%= preview %></p>
            <% end %>
          </td>
          <td class="has-text-right has-text-grey">
            <%= format_time(occurrence.completed_at) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "pager", page: @page, last_page: @last_page if @last_page > 1 %>
<% end %>